{
  "name": "autista-caa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:grammar": "esbuild tests/grammar.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/grammar-test.mjs --log-level=warning && node node_modules/.cache/grammar-test.mjs",
    "test:predict": "esbuild tests/predict.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/predict-test.mjs --log-level=warning && node node_modules/.cache/predict-test.mjs",
    "test": "npm run test:grammar && npm run test:predict && npm run test:game && npm run test:ensaio && npm run test:lexico",
    "test:game": "esbuild tests/game.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/game-test.mjs --log-level=warning && node node_modules/.cache/game-test.mjs",
    "test:ensaio": "esbuild tests/ensaio.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/ensaio-test.mjs --log-level=warning && node node_modules/.cache/ensaio-test.mjs",
    "test:lexico": "esbuild tests/lexico.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/lexico-test.mjs --log-level=warning && node node_modules/.cache/lexico-test.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.0.0"
  }
}
